# Add narrowly scoped, reviewed false-positive suppressions here.
# The thread-safety addon mistakes this state-machine callback for C exit().
threadsafety-unsafe-call:*app/logic/states/annotation/AnnotationStateMachine.h
# tinyfsm requires an exit() callback. The addon mistakes its name for C exit().
threadsafety-unsafe-call:*app/logic/states/annotation/AnnotationStates.h
threadsafety-unsafe-call:*app/logic/states/annotation/AnnotationStates.cpp
# itkNewMacro intentionally provides covariant factory methods required by ITK.
duplInheritedMember:*lib/image/WarpInversion.cpp
# Keeping the four pass programs together documents the ASCII pipeline more clearly than narrower scopes.
variableScope:*app/rendering/ascii/AsciiRenderer.cpp

# These component-typed vectors own the memory referenced by buffer after the switch.
# Moving them into the individual cases would leave buffer dangling.
variableScope:*app/logic/app/CallbackHandler.cpp

# Persistent immediate-mode UI state intentionally lives outside the narrowest lexical scope.
variableScope:*lib/ui/*

# These APIs intentionally retain instance-shaped no-op hooks for interface compatibility.
functionStatic:*lib/image/ImageSettings.cpp
# tinyfsm dispatch requires this fallback handler to remain a non-static member.
functionStatic:*app/logic/states/annotation/AnnotationStateMachine.cpp
# The directory is mutated through an iterator returned by std::find_if.
constVariablePointer:*app/logic/sync/ItkSnapSync.cpp

# Compile-time contract tests intentionally assert fixed enum values and header visibility.
knownConditionTrueFalse:*/test/*
duplicateExpression:*/test/*
suspiciousFloatingPointCast:*/test/*

# Cppcheck does not model mutations performed by ImGui through pointer arguments.
knownConditionTrueFalse:*lib/ui/ImGuiWrapper.cpp
